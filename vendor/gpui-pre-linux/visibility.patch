 impl WaylandWindowStatePtr {
+    pub(crate) fn set_visible(&self, visible: bool) {
+        let mut state = self.state.borrow_mut();
+        if !visible && state.tray_hidden {
+            return;
+        }
+        // xdg-shell has no unminimize request or portable minimized-state query.
+        // Remap an inactive surface so restore does not depend on focus permission.
+        if visible && !state.tray_hidden && state.active {
+            return;
+        }
+        state.tray_hidden = !visible;
+        state.surface.attach(None, 0, 0);
+        state.surface.commit();
+        state.pending_frame_callback = None;
+        state.presentation = PresentationState::Unpresented;
+        state.redraw_requested = true;
+        self.frame_loop.set(FrameLoop::Unconfigured);
+        if visible {
+            if let Some(toplevel) = state.surface_state.toplevel() {
+                toplevel.set_title(state.title.clone());
+                if let Some(app_id) = &state.app_id {
+                    toplevel.set_app_id(app_id.clone());
+                }
+                if let Some(size) = state.min_size {
+                    toplevel
+                        .set_min_size(f32::from(size.width) as i32, f32::from(size.height) as i32);
+                }
+                if let Some(renderer) = &state.renderer {
+                    let limit = renderer.max_texture_size() as i32;
+                    toplevel.set_max_size(limit, limit);
+                }
+                if state.maximized {
+                    toplevel.set_maximized();
+                }
+                if state.fullscreen {
+                    toplevel.set_fullscreen(None);
+                }
+            }
+            // Initial empty commit solicits configure; never attach a buffer before it.
+            state.surface.commit();
+        }
+    }
