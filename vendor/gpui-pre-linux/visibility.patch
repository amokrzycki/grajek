 impl X11WindowStatePtr {
+    pub(crate) fn set_visible(&self, visible: bool) -> anyhow::Result<()> {
+        if visible {
+            // Mapping explicitly deiconifies; activation alone can be denied by KWin.
+            self.xcb.map_window(self.x_window)?.check()?;
+            self.xcb
+                .configure_window(
+                    self.x_window,
+                    &xproto::ConfigureWindowAux::new().stack_mode(xproto::StackMode::ABOVE),
+                )?
+                .check()?;
+        } else {
+            self.xcb.unmap_window(self.x_window)?.check()?;
+            // ICCCM withdrawal removes the taskbar entry without destroying the X window.
+            let event = xproto::UnmapNotifyEvent {
+                response_type: xproto::UNMAP_NOTIFY_EVENT,
+                sequence: 0,
+                event: self.state.borrow().x_root_window,
+                window: self.x_window,
+                from_configure: false,
+            };
+            self.xcb
+                .send_event(
+                    false,
+                    self.state.borrow().x_root_window,
+                    xproto::EventMask::SUBSTRUCTURE_REDIRECT
+                        | xproto::EventMask::SUBSTRUCTURE_NOTIFY,
+                    event,
+                )?
+                .check()?;
+        }
+        self.xcb.flush()?;
+
+        Ok(())
+    }
